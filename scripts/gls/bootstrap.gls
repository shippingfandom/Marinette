((lambda () (if (== 0 (hasIndex globals 'marinette-loaded?')) (begin
    ((set globals 'SILENT' 2))

    (set globals 'marinette-loaded?' 1)

    (def shell-path (program_path))
    (def shell-parent-path (parent_path shell-path))
    (def shell-parent-name (at (split shell-parent-path '/') (to_int '-1')))

    (def marinette-glosure-path
        (if (== 'rkit' shell-parent-name)
            (+ shell-parent-path '/marinette/glosure')
            (+ (home_dir) '/rkit/marinette/glosure')))

    (def path marinette-glosure-path)
    (def paths-names (array))
    (while (!= '/' path) (begin
        (def parent-path (parent_path path))
        (push paths-names (array parent-path ((at path 'replace') ((at path 'replace') path parent-path '') '/' '')))
        (def path parent-path)))
    (reverse paths-names)

    (def computer ((at (get_shell) 'host_computer') (get_shell)))
    (foreach _ pair paths-names (begin
        (def path (at pair 0))
        (def name (at pair 1))
        ((at computer 'create_folder') computer path name)))

    (def marinette-glosure ((at computer 'File') computer marinette-glosure-path))
    (if (== 'file' (typeof marinette-glosure)) (begin
        (defun glosure-interpreter (glosure-code)
            ((at (at globals 'command') 'glosure') '-e' glosure-code))

        (defun marinette-interpret-file (file-name) (begin
            ((at computer 'touch') computer marinette-glosure-path file-name)
            (def file ((at computer 'File') computer (+ marinette-glosure-path (+ '/' file-name))))
            (if (== 'file' (typeof file)) (begin
                (def file-content ((at file 'get_content') file))
                (if (!= null file-content)
                    (glosure-interpreter file-content))))))

        (marinette-interpret-file '5hell.gls')
        (marinette-interpret-file 'marinette.gls')
        (marinette-interpret-file 'do.gls')))

    ((set globals 'SILENT' 0))))))
