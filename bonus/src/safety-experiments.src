locals.lastIndexOf = @lastIndexOf
locals.IsString = function(strRef)
	return lastIndexOf(@strRef, "") != null
end function

locals.is_match = @is_match
locals.IsFunction = function(fRef)
	notStrRef = not IsString(@fRef)
	sigRef = @fRef + ""
	isStrSigRef = IsString(@sigRef)
	return notStrRef and isStrSigRef and is_match(@sigRef, "^FUNCTION(.*)$")
end function

locals.join = @join
locals.IsList = function(listRef)
	notStrRef = not IsString(@listRef)
	notfRef = not IsFunction(@listRef)
	aPotentialListRef = IsString(join(@listRef, ""))
	return notStrRef and notfRef and aPotentialListRef
end function


cob = get_custom_object
cob.IsString = @IsString
cob.IsFunction = @IsFunction
cob.IsList = @IsList
get_shell.launch "/home/sophie/poison-attempt"
